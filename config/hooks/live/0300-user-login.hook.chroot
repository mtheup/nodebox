#!/bin/sh
# Cria o usuário "node" com senha fixa direto na imagem.
# Remove o live-config, que criava o usuário só no boot e estava falhando no login.
set -e

apt-get purge -y live-config live-config-systemd live-config-sysvinit 2>/dev/null || true
apt-get autoremove -y --purge || true

id node >/dev/null 2>&1 || useradd -m -s /bin/bash -G sudo node
echo "node:node" | chpasswd
passwd -l root || true

echo "nodebox" > /etc/hostname
echo "127.0.1.1 nodebox" >> /etc/hosts

chown node:node /srv/apps || true
