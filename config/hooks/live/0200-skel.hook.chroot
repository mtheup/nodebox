#!/bin/sh
# Modelo de home (skel) e diretório de apps
set -e

mkdir -p /srv/apps
chmod 775 /srv/apps

# O sistema entra direto no terminal. Para abrir o i3, digite: startx
cat > /etc/skel/.xinitrc <<'EOF'
exec i3
EOF

cat >> /etc/skel/.bashrc <<'EOF'

alias ll='ls -lah'
alias apps='cd /srv/apps'
alias nbs='nb status'
EOF
