#!/bin/sh
# Identidade NodeBox: os-release, issue, motd, teclado, fuso e permissões das ferramentas
set -e

NB_VERSION="0.5.1.b"

# --- os-release (com divert para o base-files não sobrescrever em atualizações) ---
dpkg-divert --local --rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release || true
cat > /usr/lib/os-release <<EOF
PRETTY_NAME="NodeBox ${NB_VERSION}"
NAME="NodeBox"
VERSION_ID="${NB_VERSION}"
VERSION="${NB_VERSION}"
VERSION_CODENAME=trixie
ID=nodebox
ID_LIKE=debian
EOF
rm -f /etc/os-release
ln -s ../usr/lib/os-release /etc/os-release

# --- Tela de login e mensagens ---
printf 'NodeBox %s \\n \\l\n\n' "$NB_VERSION" > /etc/issue
printf 'NodeBox %s\n' "$NB_VERSION" > /etc/issue.net
: > /etc/motd

# --- Hostname ---
echo "nodebox" > /etc/hostname
grep -q '127.0.1.1' /etc/hosts 2>/dev/null || echo "127.0.1.1 nodebox" >> /etc/hosts

# --- Teclado ABNT2 e fuso de São Paulo ---
cat > /etc/default/keyboard <<'EOF'
XKBMODEL="pc105"
XKBLAYOUT="br"
XKBVARIANT="abnt2"
XKBOPTIONS=""
BACKSPACE="guess"
EOF
ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime
echo "America/Sao_Paulo" > /etc/timezone

# --- Ferramentas nb (o upload pelo site do GitHub perde o bit de execução) ---
chmod 755 /usr/local/bin/nb /usr/local/bin/nb-health
