#!/bin/sh
# Configuração do live-build para a NodeBox (Debian 13 "trixie")
# Arquitetura via variável ARCH (padrão: amd64; use arm64 para Oracle Ampere A1)

ARCH="${ARCH:-amd64}"

if [ "$ARCH" = "arm64" ]; then
    LB_BOOTLOADERS="grub-efi"
    LB_IMAGE_TYPE="iso-hybrid"
else
    LB_BOOTLOADERS="grub-pc,grub-efi"
    LB_IMAGE_TYPE="iso-hybrid"
fi

lb config noauto \
    --distribution trixie \
    --architectures "$ARCH" \
    --archive-areas "main contrib non-free-firmware" \
    --binary-images "$LB_IMAGE_TYPE" \
    --bootloaders "$LB_BOOTLOADERS" \
    --debian-installer live \
    --debian-installer-gui false \
    --iso-application "NodeBox" \
    --iso-publisher "NodeBox" \
    --iso-volume "NODEBOX" \
    --image-name "nodebox" \
    --bootappend-live "boot=live components quiet splash hostname=nodebox username=node" \
    --apt-recommends false \
    --security true \
    --updates true \
    --firmware-chroot true \
    "${@}"
